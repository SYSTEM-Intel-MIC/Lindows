systemd-sysv
libpam-systemd
linux-image-amd64
firmware-linux
firmware-iwlwifi
firmware-atheros
firmware-brcm80211
firmware-realtek
firmware-misc-nonfree
firmware-amd-graphics
firmware-intel-sound

# X11 session, ElevenDE native display service and lightweight compositor/window manager
