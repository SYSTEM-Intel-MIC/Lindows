#!/bin/sh
# Mark an intentional ElevenDE logout before requesting the Openbox exit.
# The display service consumes this per-user marker and starts a fresh native
# login session on the existing X server.  No root action or loginctl session
# termination is involved, so the action cannot strand the user at a root TTY.
set -eu

marker="$HOME/.cache/lindows-elevende-logout"
mkdir -p "$(dirname "$marker")"
touch "$marker"
exec openbox --exit
