#!/bin/sh
# SAS logout returns to ElevenDE's native password gate on the current X
# session.  Do not exit Openbox: that tears down the shell/taskbar and forces
# the display service to recreate an entire desktop, which is unsafe during
# concurrent RandR events and previously produced a black root window.
set -eu

if [ -x /usr/local/bin/elevende-lock ]; then
    exec /usr/local/bin/elevende-lock --login
fi

# A missing native login gate is a configuration failure, not a reason to
# terminate the session and strand the user on a console.
printf '%s\n' 'Lindows logout: ElevenDE login gate is unavailable' >&2
exit 1
