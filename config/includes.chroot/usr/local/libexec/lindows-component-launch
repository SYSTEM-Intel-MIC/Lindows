#!/bin/sh
# Lindows desktop-integration adapter for third-party component entry points.
# It deliberately changes only desktop/session integration; application logic
# remains upstream-owned and is isolated in its individual Debian package.
set -eu

[ "$#" -gt 0 ] || exit 64
export XDG_CURRENT_DESKTOP=ElevenDE
export XDG_SESSION_DESKTOP=ElevenDE
export XDG_SESSION_TYPE=x11
export XDG_DATA_DIRS="/usr/local/share:/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
export GDK_BACKEND=x11
export GTK_CSD=0
export MOZ_GTK_TITLEBAR_DECORATION=system
export QT_QPA_PLATFORM=xcb
# Lindows 2.0 is light-only.  Do not inherit a dark portal/theme preference
# into third-party GTK or Qt apps, because that yields black surfaces beside
# ElevenDE's fixed Windows 11 light palette.
export GTK_THEME=Adwaita:light
export GTK_APPLICATION_PREFER_DARK_THEME=0
export QT_STYLE_OVERRIDE=Fusion
export QT_QPA_PLATFORMTHEME=""
exec "$@"
