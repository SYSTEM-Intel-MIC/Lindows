[Unit]
Description=Initialize the Lindows Live graphical session user
Before=lindows-elevende-display.service
After=local-fs.target systemd-tmpfiles-setup.service
Wants=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lindows-live-session-init
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
